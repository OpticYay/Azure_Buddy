{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=azurebuddy;user=azurebuddy;password=CHANGE_ME"
  },
  "Jwt": {
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "AzureBuddy",
    "Audience": "AzureBuddy",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "DataProtection": {
    "KeyPath": "DataProtection-Keys"
  },
  "Ado": {
    "ApiVersion": "7.1"
  },
  "Llm": {
    "Providers": [ "Gemini", "Ollama" ],
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-1.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "TimeoutSeconds": 30
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5:14b-instruct",
      "NumCtx": 8192,
      "TimeoutSeconds": 60
    }
  }
}
