{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=azurebuddy;user=azurebuddy;password=CHANGE_ME"
  },
  "Jwt": {
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "Issuer": "AzureBuddy",
    "Audience": "AzureBuddy",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "DataProtection": {
    "KeyPath": "DataProtection-Keys"
  },
  "Redis": {
    "//": "Leave Configuration blank to run without Redis - chat history, Data Protection keys, and LLM settings changes stay in-memory/per-instance (see README's Horizontal scaling section). Required to run more than one API replica.",
    "Configuration": "",
    "InstanceName": "azurebuddy:",
    "ChatWindowTtlHours": 24
  },
  "App": {
    "//": "Used to build password-reset/email-confirmation links sent by email - point this at wherever the Angular app is actually served.",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Email": {
    "Smtp": {
      "//": "Leave Host blank to run without real email - password-reset/confirmation links are logged instead of sent (see NoOpEmailSender).",
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "CHANGE_ME",
      "EnableSsl": true,
      "FromAddress": "",
      "FromDisplayName": "Azure Buddy"
    }
  },
  "Ado": {
    "ApiVersion": "7.1"
  },
  "Llm": {
    "Providers": [ "Gemini", "Ollama" ],
    "Gemini": {
      "ApiKey": "",
      "Model": "gemini-1.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "TimeoutSeconds": 30
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5:14b-instruct",
      "NumCtx": 8192,
      "TimeoutSeconds": 60
    }
  }
}
