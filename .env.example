# Copy this file to .env (gitignored) and fill in real values - docker-compose.yml reads from .env
# automatically. Never commit the real .env.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=azurebuddy
MYSQL_USER=azurebuddy
MYSQL_PASSWORD=CHANGE_ME
# Host-side port MySQL is published on (container-internal port is always 3306). Defaults to 3307 to
# avoid colliding with a MySQL already running locally on the standard port.
MYSQL_PORT=3307

# 32+ random bytes - treat like a password, a leaked signing key lets anyone mint valid tokens.
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional - leave blank to run with only the Ollama fallback provider.
GEMINI_API_KEY=

# No Redis variables needed here - docker-compose.yml points both `api` and `api2` at the compose
# network's own "redis" service directly (Redis__Configuration=redis:6379), not through .env. Redis
# itself isn't published to the host; if you need to inspect it locally, run
# `docker compose exec redis redis-cli`.
